Options -Indexes

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|phpunit\.xml|phpstan\.neon|phpcs\.xml|AGENTS\.md|CODEX\.md|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(admin|app|config|database|docs|resources|tests|vendor)(/|$) - [F,L]
</IfModule>

# DonWeb recomendado: configurar el document root del dominio en /public.
# Este archivo reduce riesgos si el proyecto completo queda visible por error.
